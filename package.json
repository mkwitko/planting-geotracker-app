{
  "name": "plantio-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "orval": "cross-env TERMINAL_ENV=local npx orval --config ./orval.config.ts",
    "orvalProd": "cross-env TERMINAL_ENV=production npx orval --config ./orval.config.ts",
    "apk": "cd android && ./gradlew assembleRelease && cp ./app/build/outputs/apk/release/app-release.apk ../ && cd ../",
    "apkClean": "cd android && ./gradlew clean && ./gradlew assembleRelease && cp ./app/build/outputs/apk/release/app-release.apk ../ && cd ../"
  },
